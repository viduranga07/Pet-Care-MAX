<jasperReport name="PaymentReport" language="java" pageWidth="842" pageHeight="595" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="25" bottomMargin="25" uuid="7a3a8f9b-7d7d-4e39-9e1d-8b5a8c0a1001">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="PetCareMAX MySQL"/>
    <property name="com.jaspersoft.studio.data.sql.tables" value=""/>

    <query language="sql"><![CDATA[
SELECT
    p.payment_id AS payment_id,
    c.full_name AS customer_name,
    pt.pet_name AS pet_name,
    a.appointment_date AS appointment_date,
    a.appointment_time AS appointment_time,
    p.amount AS amount,
    p.payment_method AS payment_method,
    p.payment_date AS payment_date,
    p.status AS payment_status
FROM payments p
INNER JOIN appointments a
    ON p.appointment_id = a.appointment_id
INNER JOIN pets pt
    ON a.pet_id = pt.pet_id
INNER JOIN customers c
    ON pt.customer_id = c.customer_id
ORDER BY p.payment_date DESC
    ]]></query>

    <field name="payment_id" class="java.lang.Integer"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="pet_name" class="java.lang.String"/>
    <field name="appointment_date" class="java.sql.Date"/>
    <field name="appointment_time" class="java.sql.Time"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="payment_method" class="java.lang.String"/>
    <field name="payment_date" class="java.sql.Timestamp"/>
    <field name="payment_status" class="java.lang.String"/>

