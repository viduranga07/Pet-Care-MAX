<jasperReport name="AppointmentReport" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d57d3905-2f4d-4bfc-b4e8-258084d6b6a1">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PetCareMAX_MySQL.jrdax"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="sql"><![CDATA[SELECT
    a.appointment_id,
    c.full_name AS customer_name,
    c.phone AS customer_phone,
    p.pet_name,
    p.species,
    p.breed,
    v.full_name AS veterinarian_name,
    v.specialization,
    s.service_name,
    s.price,
    a.appointment_date,
    a.appointment_time,
    a.reason,
    a.status
FROM appointments a
JOIN pets p
    ON a.pet_id = p.pet_id
JOIN customers c
    ON p.customer_id = c.customer_id
JOIN veterinarians v
    ON a.veterinarian_id = v.veterinarian_id
JOIN services s
    ON a.service_id = s.service_id
ORDER BY
    a.appointment_date DESC,
    a.appointment_time DESC]]></query>
